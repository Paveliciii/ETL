namespace Shell.UI
{
    using System;
    using System.Collections.Generic;

    // Minimal stubs to satisfy compile-time dependencies present in external assemblies.
    public class ETLConnectionPair
    {
        public DateTime LastAccessDate { get; set; }
        public string ConnectionString { get; set; }
    }

    public class ETLSettings
    {
        public static ETLSettings Preferences { get; } = new ETLSettings();

        public Dictionary<string, object> DataSources { get; } = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);

        public Dictionary<string, ETLConnectionPair> ScenarioConnections { get; } = new Dictionary<string, ETLConnectionPair>(StringComparer.OrdinalIgnoreCase);
    }

    public class ConnectionEntry
    {
        public object Caller { get; set; }
        public string ConnectionString { get; set; }
    }

    public interface ISqlFormService
    {
        bool ShowScenarioForm(object owner, string sourceName, string destinationName, ETLConnectionPair pair);
        bool ShowSqlServerForm(ConnectionEntry entry);
    }
}
